# ============================================================
# portal.${BASE_DOMAIN} -> portal 컨테이너
#
# 서비스 하나당 파일 하나. 새 서비스를 붙일 때는
# 이 파일을 복사해서 server_name과 proxy_pass만 바꾸면 된다.
#
# 이 파일은 템플릿이다. nginx 이미지 entrypoint가 기동 시 envsubst로
# ${...} 를 치환해 /etc/nginx/conf.d/portal.conf 로 쓴다.
#   NGINX_LISTEN  로컬 80 / VPS "443 ssl"
#   BASE_DOMAIN   로컬 localhost / VPS kkh-hub.tech
#   TLS_MODE      로컬 none(빈 파일) / VPS live(인증서 경로)
# ============================================================

server {
    # 로컬은 80(평문), VPS는 "443 ssl".
    # ssl 키워드가 있어야 아래 include의 ssl_certificate가 의미를 가진다.
    listen ${NGINX_LISTEN};

    # 이 블록이 담당할 도메인.
    # 브라우저가 TLS 핸드셰이크 때 SNI로 도메인을 먼저 알려주기 때문에
    # nginx는 인증서를 고르기 전에 어느 server 블록인지 판단할 수 있다.
    # *.localhost는 브라우저가 자동으로 127.0.0.1로 풀어주므로
    # 로컬에서 hosts 파일을 수정할 필요가 없다.
    server_name portal.${BASE_DOMAIN};

    # TLS 지시자를 모드별 파일로 분리한다. 로컬은 빈 파일이므로 인증서 없이 기동된다.
    include /etc/nginx/tls/${TLS_MODE}.conf;

    # 이 도메인으로 들어온 모든 경로를 처리.
    location / {
        # 요청을 뒤쪽 컨테이너로 그대로 전달한다.
        # portal = Docker 컨테이너(서비스) 이름. IP를 쓸 필요 없다.
        #   같은 vps_proxy 네트워크에 있으면 Docker 내부 DNS가 이름을 풀어준다.
        # 8080 = portal 컨테이너 안에서 Go 서버가 듣고 있는 포트.
        #        호스트에 publish되지 않았으므로 외부에서는 접근 불가.
        # http = nginx와 컨테이너 사이 내부 구간은 암호화하지 않는다.
        proxy_pass http://portal:8080;

        # --- 아래 4줄이 필요한 이유 ---
        # nginx가 대신 요청을 보내면, 뒤쪽 앱 입장에서는
        # 모든 요청이 nginx에서 온 것으로 보인다.
        # 원래 사용자 정보가 사라지므로 헤더에 담아 따로 넘겨준다.

        # 원래 사용자가 접속한 도메인. 이게 없으면 앱이 "portal"로 인식한다.
        proxy_set_header Host $host;

        # 실제 클라이언트 IP. 없으면 앱은 nginx 컨테이너 IP만 보게 된다.
        proxy_set_header X-Real-IP $remote_addr;

        # 프록시를 여러 번 거쳤을 때의 IP 목록(쉼표 구분).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 사용자가 http로 왔는지 https로 왔는지.
        # 내부 구간은 http라서 앱이 이걸 봐야 원래 프로토콜을 안다.
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
