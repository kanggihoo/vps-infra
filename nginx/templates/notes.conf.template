# ============================================================
# notes.${BASE_DOMAIN} -> Quartz 정적 사이트
#
# 다른 템플릿과 다른 점: proxy_pass가 없다.
# Quartz 빌드 결과물은 HTML 파일 더미라서 서버 프로세스가 필요 없고,
# nginx가 파일을 직접 읽어 응답한다.
#
# 파일 출처: 예전에는 Jenkins가 quartz-site-private를 빌드해 quartz-site 볼륨에 배치했다.
#            Jenkins를 걷어낸 뒤(ADR 0021) 자동 빌드 경로는 없다. 볼륨에 남은 결과물을 서빙한다.
# ============================================================

server {
    listen ${NGINX_LISTEN};
    server_name notes.${BASE_DOMAIN};

    include /etc/nginx/tls/${TLS_MODE}.conf;

    # 정적 파일을 찾을 기준 폴더.
    root /var/www/notes;

    # 개인 노트이므로 Tinyauth SSO로 보호한다. 모든 location이 server 단위 auth_request를 상속한다.
    include /etc/nginx/conf.d/snippets/tinyauth.conf;

    location / {
        # Quartz는 /some/note 처럼 확장자 없는 URL을 만든다.
        # 순서대로 시도해서 처음 존재하는 것을 응답한다.
        #   $uri             그대로 (이미지, css 등)
        #   $uri.html        .html 붙여서 (대부분의 노트)
        #   $uri/index.html  폴더면 그 안의 index
        #   마지막은 404
        try_files $uri $uri.html $uri/index.html =404;
    }

    # 인증된 개인 노트 자산은 브라우저 밖으로 캐시가 나가면 안 된다.
    # Quartz 산출물이 실제 content hash 파일명인지 보장하지 않으므로 immutable도 쓰지 않는다.
    location ~* \.(css|js|woff2?|png|jpg|jpeg|gif|svg|ico|webp)$ {
        add_header Cache-Control "private, no-store";

        try_files $uri =404;
    }

    # Quartz가 만든 404 페이지를 사용한다. 이 페이지도 인증 뒤에만 보인다.
    # 미인증으로 /404.html이나 /tinyauth(internal)를 직접 부르면 404 -> /404.html -> 401 순서로
    # 오류 페이지 안에서 다시 오류가 난다. recursive_error_pages가 꺼져 있으면 401이 그대로 나가
    # 로그인 302가 되지 않으므로 켠다. 체인은 @tinyauth_login의 return에서 끝나 반복되지 않는다.
    recursive_error_pages on;
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
