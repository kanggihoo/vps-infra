# ============================================================
# notes.${BASE_DOMAIN} -> Quartz 정적 사이트
#
# 다른 템플릿과 다른 점: proxy_pass가 없다.
# Quartz 빌드 결과물은 HTML 파일 더미라서 서버 프로세스가 필요 없고,
# nginx가 파일을 직접 읽어 응답한다.
#
# 파일 출처: Jenkins가 quartz-site-private를 빌드해 quartz-site 볼륨에 배치.
#            단계 7에서 이미지화하면 proxy_pass 방식으로 바뀐다.
# ============================================================

server {
    listen ${NGINX_LISTEN};
    server_name notes.${BASE_DOMAIN};

    include /etc/nginx/tls/${TLS_MODE}.conf;

    # 정적 파일을 찾을 기준 폴더.
    root /var/www/notes;

    # 개인 노트이므로 Basic Auth로 보호한다.
    # 사용자 파일은 SOPS로 복호화해 secrets/notes.htpasswd에 생성한다(단계 3).
    auth_basic           "Notes";
    auth_basic_user_file /etc/nginx/notes.htpasswd;

    location / {
        # Quartz는 /some/note 처럼 확장자 없는 URL을 만든다.
        # 순서대로 시도해서 처음 존재하는 것을 응답한다.
        #   $uri             그대로 (이미지, css 등)
        #   $uri.html        .html 붙여서 (대부분의 노트)
        #   $uri/index.html  폴더면 그 안의 index
        #   마지막은 404
        try_files $uri $uri.html $uri/index.html =404;
    }

    # 인증된 개인 노트 자산은 브라우저 밖으로 캐시가 나가면 안 된다.
    # Quartz 산출물이 실제 content hash 파일명인지 보장하지 않으므로 immutable도 쓰지 않는다.
    location ~* \.(css|js|woff2?|png|jpg|jpeg|gif|svg|ico|webp)$ {
        add_header Cache-Control "private, no-store";

        # 이 블록은 위 server 단위 auth_basic을 상속하지만,
        # location 블록에서 다시 선언해야 확실히 적용된다.
        auth_basic           "Notes";
        auth_basic_user_file /etc/nginx/notes.htpasswd;

        try_files $uri =404;
    }

    # Quartz가 만든 404 페이지를 사용한다.
    error_page 404 /404.html;
    location = /404.html {
        internal;
        auth_basic off;
    }
}
