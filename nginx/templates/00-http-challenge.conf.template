# ============================================================
# 80번 포트(평문 HTTP) 담당 — VPS 전용 동작
#
# 파일명이 00- 으로 시작하는 이유:
#   nginx는 include된 파일을 알파벳 순으로 읽는다.
#   80번 처리를 가장 먼저 정의해두려는 것뿐. 기능상 강제는 아니다.
#
# 하는 일 두 가지:
#   1. 인증서 발급용 경로만 파일로 응답
#   2. 나머지 전부 HTTPS로 돌려보냄
#
# 로컬(TLS_MODE=none)에서는 이 server 블록이 있으면 안 된다.
#   - 로컬은 80이 서비스 포트다. 여기서 443으로 301을 주면 모든 로컬 요청이
#     인증서 없는 HTTPS로 튕겨 검증이 불가능해진다.
#   - 그래서 challenge/redirect 본문을 tls/${TLS_MODE}-challenge.conf로 분리했다.
#     none = 빈 파일, live = 아래 두 location.
#
# 새 서브도메인을 추가하면 CHALLENGE_DOMAINS(.env)에도 넣어야 인증서 발급이 된다.
# 이 함정은 의도적으로 유지된다 — 누락 시 발급이 실패해 즉시 드러난다.
# ============================================================

server {
    # 80번 포트에서 요청을 받는다. ssl 안 붙었으니 평문 HTTP.
    listen 80;

    # 이 server 블록이 담당할 도메인 목록.
    # 요청의 Host 헤더와 여기를 대조해서 어느 server 블록을 쓸지 고른다.
    server_name ${CHALLENGE_DOMAINS};

    include /etc/nginx/tls/${TLS_MODE}-challenge.conf;
}
