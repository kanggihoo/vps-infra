# ============================================================
# health.${BASE_DOMAIN} -> whoami 컨테이너
#
# 구조는 portal.conf.template과 동일. 상세 주석은 그쪽 참고.
# 차이점: 목적지가 whoami:80 이라는 것뿐.
#
# whoami = 받은 요청 정보를 그대로 텍스트로 돌려주는 진단용 컨테이너.
#          DNS/TLS/라우팅이 정상인지 확인하는 용도.
# ============================================================

server {
    listen ${NGINX_LISTEN};
    server_name health.${BASE_DOMAIN};

    include /etc/nginx/tls/${TLS_MODE}.conf;

    # 후보 nginx 설정은 backend가 아직 없는 최초 배포에서도 검사해야 한다.
    # 변수 upstream은 Docker DNS 해석을 요청 시점으로 미뤄 `nginx -t`를 가능하게 한다.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        # whoami 이미지는 80번 포트에서 듣는다 (portal의 8080과 다름).
        set $whoami_upstream "whoami:80";
        proxy_pass http://$whoami_upstream$request_uri;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
