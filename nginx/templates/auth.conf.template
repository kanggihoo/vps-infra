# ============================================================
# auth.${BASE_DOMAIN} -> tinyauth 컨테이너 (로그인 포털, OAuth 콜백)
#
# 공개 서브도메인이다. 보호 서브도메인(erd, notes, info, grafana)은
# snippets/tinyauth.conf로 이 서비스에 인증을 묻는다.
# 세션 쿠키는 상위 도메인(${BASE_DOMAIN})에 걸려 보호 서브도메인 모두에 전송된다.
# ============================================================

server {
    listen ${NGINX_LISTEN};
    server_name auth.${BASE_DOMAIN};

    include /etc/nginx/tls/${TLS_MODE}.conf;

    # tinyauth가 없어도 nginx가 기동하도록 이름 해석을 요청 시점으로 미룬다.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        set $tinyauth_upstream "tinyauth:3000";
        proxy_pass http://$tinyauth_upstream$request_uri;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
