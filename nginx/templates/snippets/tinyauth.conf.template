# ============================================================
# Tinyauth forward-auth (보호 서브도메인 server 블록에서 include한다)
#
#   include /etc/nginx/conf.d/snippets/tinyauth.conf;
#
# nginx 이미지 entrypoint는 templates/ 하위 폴더도 같은 구조로 conf.d/에 렌더한다.
# nginx.conf는 conf.d/*.conf만 http 단위로 읽으므로 snippets/는 여기서 include할 때만 쓰인다.
#
# 모든 요청(정적 자산, WebSocket, error_page 내부 이동 포함)이 먼저 /tinyauth subrequest를 거친다.
# Tinyauth가 200이면 통과, 401이면 auth.${BASE_DOMAIN} 로그인으로 302를 준다.
# 그 밖의 응답(500 등)은 nginx가 500으로 돌려준다. 어느 경우도 미인증 200은 없다.
# ============================================================

auth_request /tinyauth;
error_page 401 = @tinyauth_login;

location = /tinyauth {
    # 외부에서 /tinyauth를 직접 부르면 404다. auth_request subrequest만 들어온다.
    internal;
    # tinyauth 컨테이너가 없어도 nginx -t가 통과하도록 이름 해석을 요청 시점으로 미룬다.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $tinyauth_upstream "tinyauth:3000";
    proxy_pass http://$tinyauth_upstream/api/auth/nginx;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Forwarded-Proto $scheme;
    # 클라이언트가 보낸 X-Forwarded-Host는 버리고 실제 Host로 덮어쓴다(헤더 스푸핑 차단).
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Uri $request_uri;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location @tinyauth_login {
    return 302 $scheme://auth.${BASE_DOMAIN}/login?redirect_uri=$scheme://$http_host$request_uri;
}
