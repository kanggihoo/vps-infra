[Unit]
Description=Renew VPS TLS certificates and reload nginx
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# 이 파일에는 checkout 경로만 둔다. secret은 .env에서 compose가 읽는다.
EnvironmentFile=/etc/vps-infra/certbot-renew.env
# $$는 systemd가 literal $로 바꾸므로 bash가 APP_DIR을 확장한다.
ExecStart=/bin/bash -c 'cd "$${APP_DIR}" && exec ./scripts/renew-certificates.sh'
