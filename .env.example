# 이 파일을 복사해 .env로 쓴다. 실제 값은 SOPS로 암호화해 관리한다(단계 3).
#   docker compose run --rm tools ./scripts/secrets.sh decrypt

# --- 환경 (로컬 기본값) ---
# VPS에서는 BASE_DOMAIN=kkh-hub.tech, NGINX_LISTEN="443 ssl", TLS_MODE=live
#
# 로컬 도메인이 localhost가 아니라 vps.localhost인 이유: Tinyauth는 localhost를 TLD로 보고
# 세션 쿠키를 auth.localhost에만 걸어 erd.localhost 등에서 SSO가 되지 않는다.
# *.localhost는 브라우저가 127.0.0.1로 풀어주므로 hosts 파일은 그대로 둔다.
#
# ⚠️ 공백이 들어가는 값은 반드시 따옴표로 감싼다(예: NGINX_LISTEN="443 ssl").
# compose는 따옴표 없이도 읽지만, scripts/deploy.sh와 healthcheck.sh가
# `. ./.env`로 source하므로 따옴표가 없으면 "ssl: command not found"로 죽는다.
BASE_DOMAIN=vps.localhost
NGINX_LISTEN=80
TLS_MODE=none

# 80번 포트 challenge 블록이 담당할 도메인 목록(공백 구분).
# 새 서브도메인을 추가하면 여기에도 넣어야 인증서 발급이 된다.
# VPS: kkh-hub.tech health.kkh-hub.tech portal.kkh-hub.tech notes.kkh-hub.tech info.kkh-hub.tech erd.kkh-hub.tech grafana.kkh-hub.tech auth.kkh-hub.tech
#
# 로컬은 certbot을 쓰지 않으므로 실제 서비스와 겹치지 않는 더미 이름을 둔다.
# 로컬 도메인을 넣으면 portal.vps.localhost 등과 충돌해 nginx가 경고를 낸다.
CHALLENGE_DOMAINS=acme-challenge.invalid

# --- Tinyauth SSO (erd, notes, info, grafana 보호) ---
# 로그인 포털 주소. VPS: https://auth.kkh-hub.tech
TINYAUTH_APPURL=http://auth.vps.localhost
# 로컬 계정. user:bcrypt 해시, 쉼표로 여러 명. 아래는 공개 테스트 계정(test/test)이다.
# TLS_MODE=live 배포는 test 계정과 빈 값을 거부한다.
# ⚠️ 해시에 $가 있으므로 반드시 작은따옴표로 감싼다(deploy.sh가 set -u로 source한다).
# 해시 만들기: htpasswd -nbB -C 10 <아이디> <비밀번호>
TINYAUTH_AUTH_USERS='test:$2y$10$cnmID6hRmbcfTBoSH7D5L.jg1wZFpByYtH7KTWeKwsJQmp6rHreoi'
# VPS(https)에서만 true.
TINYAUTH_AUTH_SECURECOOKIE=false
# Google OAuth 허용 이메일(쉼표 구분). 비어 있으면 모든 Google 계정이 통과하므로
# Google client를 설정했거나 TLS_MODE=live면 deploy.sh가 빈 값을 거부한다.
TINYAUTH_OAUTH_WHITELIST=
# Google OAuth client. 로컬은 비워 두면 로컬 계정만 쓴다.
# 리디렉션 URI: <TINYAUTH_APPURL>/api/oauth/callback/google
TINYAUTH_OAUTH_PROVIDERS_GOOGLE_CLIENTID=
TINYAUTH_OAUTH_PROVIDERS_GOOGLE_CLIENTSECRET=

# 헬스체크가 확인할 도메인. 하드코딩을 제거해 로컬에서도 동작하게 했다.
HEALTHCHECK_HOST=health.vps.localhost
# 로컬은 http, VPS는 https
HEALTHCHECK_SCHEME=http
# portal 자체도 nginx를 경유해 확인한다. VPS: portal.kkh-hub.tech
PORTAL_HEALTHCHECK_HOST=portal.vps.localhost

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example-postgres-password
POSTGRES_DB=postgres

# --- Redis ---
REDIS_PASSWORD=example-redis-password

# --- 관측 스택 (ADR 0016, observability/compose.yml) ---
# Grafana 기본 admin 계정. 최초 기동 때만 적용된다. 로그인은 Tinyauth SSO(Auth Proxy)로 한다.
# 특수문자가 있으면 작은따옴표로 감싼다(deploy.sh가 셸로 source한다).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=example-grafana-password
# VPS(https)에서만 true.
GRAFANA_COOKIE_SECURE=false
# 알림을 보낼 Mattermost incoming webhook. 로컬은 비워 둔다(아무 데도 닿지 않는 주소로 대체된다).
GRAFANA_ALERT_WEBHOOK_URL=
