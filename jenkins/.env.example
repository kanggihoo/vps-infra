# 이 파일을 복사해 jenkins/.env로 쓴다.
#   cp jenkins/.env.example jenkins/.env

# 호스트 docker 그룹 GID. Jenkins가 docker.sock을 쓰려면 필요하다.
#   Linux: getent group docker | cut -d: -f3
#   macOS(OrbStack/Docker Desktop): 보통 0
DOCKER_GID=999

# --- 관리자 계정 (JCasC가 생성한다) ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-before-use

# 로컬: http://localhost:8080/  VPS: https://jenkins.kkh-hub.tech/
JENKINS_URL=http://localhost:8080/

# --- 리소스 제한 ---
# mem_limit보다 heap을 낮게 둔다. 같게 두면 heap이 차기 전에 컨테이너가 죽는다.
JENKINS_MEM_LIMIT=2g
JENKINS_HEAP_MAX=1g

# --- 배포 경로 ---
# 호스트 경로와 컨테이너 경로가 같아야 한다(docker.sock 제약).
# 로컬에서 이 레포 자체를 쓰려면 APP_DIR_HOST를 레포 경로로 지정한다.
APP_DIR=/app/vps-infra
# APP_DIR_HOST=/Users/you/Desktop/vps/vps-infra

# --- SCM ---
# 로컬은 마운트된 레포 경로를 그대로 쓴다. push하지 않은 커밋도 테스트할 수 있다.
INFRA_SCM_URL=/app/vps-infra
# VPS: https://github.com/<owner>/vps-infra.git
# 로컬 경로 SCM은 credential이 필요 없으므로 비워둔다.
SCM_CREDENTIAL_ID=

# 로컬 경로를 SCM으로 쓰려면 true여야 한다.
# Jenkins는 기본적으로 local directory checkout을 "insecure"로 거부한다.
# VPS에서는 GitHub URL을 쓰므로 false로 둔다.
ALLOW_LOCAL_CHECKOUT=true

# Quartz 레포. 비워두면 quartz-deploy Job을 만들지 않는다.
QUARTZ_SCM_URL=

# --- credential (JCasC가 등록한다) ---
GITHUB_PAT_USER=git
GITHUB_PAT_TOKEN=unset

# SOPS 복호화 age key 파일의 내용 전체.
#   VPS: SOPS_AGE_KEY_CONTENT="$(cat ~/.config/sops/age/keys.txt)"
SOPS_AGE_KEY_CONTENT=
