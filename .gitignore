# Runtime secrets
.env
.env.*
!.env.example
*.htpasswd
# SOPS 복호화 결과물(평문)은 커밋하지 않는다.
# 암호화 파일은 `secrets/*.sops`이며 위 패턴에 걸리지 않으므로 그대로 커밋된다.
# age 복호화 key는 절대 커밋하지 않는다.
keys.txt
*.age

# Let's Encrypt state (managed via certbot named volumes, not repo paths)

# Local data and backups
data/
volumes/
backups/
.deploy-state/
*.dump
*.sql
*.sql.gz
*.rdb
*.aof

# Logs
logs/
*.log

# Tool caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
dist/
.DS_Store

# Editor / OS
.icdea/
.vscode/
*.swp
*.swo

# Graphify generated output
graphify-out/

.playwright-cli/
output/

# scripts/test-nginx-templates.sh가 실행 중에 만드는 더미 인증서
.nginx-template-test.*/
