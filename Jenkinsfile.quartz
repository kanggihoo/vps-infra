// Quartz 노트 사이트 배포 파이프라인.
//
// 트리거: quartz-site-private 저장소 push (obsidian -> quartz 동기화 Actions의 결과)
// 결과물: /opt/quartz-site/ 에 정적 파일 배치 -> nginx가 notes.kkh-hub.tech로 서빙
//
// Jenkins 이미지에 Node가 없으므로 node:22-alpine 컨테이너로 빌드한다.
// Jenkins 컨테이너는 호스트 Docker socket을 쓰므로, 여기서 실행하는 docker run은
// 호스트에서 실행된다. 따라서 -v 경로도 호스트 기준이어야 한다.

pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    environment {
        // 호스트 기준 작업 경로. Jenkins 워크스페이스가 아니라 별도 폴더를 쓴다.
        // 이유: node 컨테이너가 마운트할 때 호스트 경로가 필요한데,
        //       Jenkins 워크스페이스는 컨테이너 내부 경로라 그대로 쓸 수 없다.
        BUILD_DIR  = '/opt/quartz-build'
        DEPLOY_DIR = '/opt/quartz-site'
        NODE_IMAGE = 'node:22-alpine'
    }

    stages {
        stage('Checkout') {
            steps {
                // 최초 실행이면 clone, 이후에는 fetch + reset으로 최신화한다.
                // credentialsId는 Jenkins 자격증명에 등록한 GitHub PAT.
                withCredentials([usernamePassword(
                    credentialsId: 'github-pat',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        repo="https://${GIT_USER}:${GIT_TOKEN}@github.com/kanggihoo/quartz-site-private.git"

                        if [ -d "${BUILD_DIR}/.git" ]; then
                            echo "[checkout] updating existing clone"
                            git -C "${BUILD_DIR}" remote set-url origin "$repo"
                            git -C "${BUILD_DIR}" fetch --depth 1 origin main
                            git -C "${BUILD_DIR}" reset --hard origin/main
                            git -C "${BUILD_DIR}" clean -fd -e node_modules -e .quartz
                        else
                            echo "[checkout] fresh clone"
                            mkdir -p "${BUILD_DIR}"
                            git clone --depth 1 -b main "$repo" "${BUILD_DIR}"
                        fi

                        # 토큰이 .git/config에 남지 않도록 정리한다.
                        git -C "${BUILD_DIR}" remote set-url origin \
                            https://github.com/kanggihoo/quartz-site-private.git

                        echo "[checkout] HEAD: $(git -C "${BUILD_DIR}" rev-parse --short HEAD)"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                // node_modules와 .quartz/plugins는 BUILD_DIR에 남아 다음 빌드에서 재사용된다.
                // npm ci는 package-lock.json이 바뀌지 않으면 빠르게 끝난다.
                sh '''
                    set -eu

                    docker run --rm \
                        -v "${BUILD_DIR}:/app" \
                        -w /app \
                        ${NODE_IMAGE} \
                        sh -c '
                            set -eu
                            # quartz plugin install이 github에서 플러그인을 받아오므로 git이 필요하다.
                            apk add --no-cache git >/dev/null

                            echo "[build] npm ci"
                            npm ci --no-audit --no-fund

                            echo "[build] installing quartz plugins"
                            npx quartz plugin install --from-config

                            echo "[build] quartz build"
                            npx quartz build
                        '

                    test -f "${BUILD_DIR}/public/index.html"
                    echo "[build] generated $(find "${BUILD_DIR}/public" -type f | wc -l) files"
                '''
            }
        }

        stage('Deploy') {
            steps {
                // rsync로 차이만 반영한다. --delete로 삭제된 노트도 정리된다.
                // 임시 폴더가 아니라 직접 갱신하므로 순간적으로 일부 파일이 없을 수 있으나,
                // 개인용 사이트라 무중단 전환까지는 필요하지 않다.
                sh '''
                    set -eu
                    mkdir -p "${DEPLOY_DIR}"

                    docker run --rm \
                        -v "${BUILD_DIR}/public:/src:ro" \
                        -v "${DEPLOY_DIR}:/dst" \
                        ${NODE_IMAGE} \
                        sh -c 'apk add --no-cache rsync >/dev/null && rsync -a --delete /src/ /dst/'

                    echo "[deploy] deployed $(find "${DEPLOY_DIR}" -type f | wc -l) files"
                '''
            }
        }

        stage('Verify') {
            steps {
                // nginx를 거쳐 실제로 응답하는지 확인한다.
                // Basic Auth가 걸려 있으므로 401이 정상 응답이다.
                sh '''
                    set -eu
                    status="$(curl -sS -o /dev/null -w "%{http_code}" \
                        --connect-to notes.kkh-hub.tech:443:vps-nginx:443 \
                        https://notes.kkh-hub.tech/ || true)"

                    echo "[verify] HTTP ${status}"
                    test "$status" = "401"
                '''
            }
        }
    }

    post {
        failure {
            echo 'Quartz 배포 실패. docker compose logs nginx 와 위 빌드 로그를 확인한다.'
        }
    }
}
