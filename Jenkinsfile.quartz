// Quartz 노트 사이트 배포 파이프라인.
//
// 트리거: quartz-site-private 저장소 push
//         (obsidian -> quartz 동기화는 GitHub Actions가 담당)
// 결과물: /opt/quartz-site/ 에 정적 파일 -> nginx가 notes.kkh-hub.tech로 서빙
//
// /opt/quartz-build 와 /opt/quartz-site 는 jenkins/compose.yml에서
// 호스트와 같은 경로로 마운트되어 있다. 그래서 Jenkins가 직접 접근할 수 있고,
// docker run의 -v 경로(호스트 기준)와도 값이 일치한다.

pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    environment {
        BUILD_DIR  = '/opt/quartz-build'
        DEPLOY_DIR = '/opt/quartz-site'
        // alpine이 아니라 slim(Debian)을 쓴다.
        // Quartz CLI 셔뱅이 `#!/usr/bin/env -S node`인데 alpine의 BusyBox env에는
        // -S 옵션이 없어 실행되지 않는다. Quartz 공식 Dockerfile도 slim을 쓴다.
        NODE_IMAGE = 'node:22-slim'
        REPO       = 'github.com/kanggihoo/quartz-site-private.git'
    }

    stages {
        stage('Checkout') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-pat',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        url="https://${GIT_USER}:${GIT_TOKEN}@${REPO}"

                        if [ -d "${BUILD_DIR}/.git" ]; then
                            echo "[checkout] fetching latest"
                            git -C "${BUILD_DIR}" remote set-url origin "$url"
                        else
                            echo "[checkout] initializing"
                            git -C "${BUILD_DIR}" init -q
                            git -C "${BUILD_DIR}" remote add origin "$url"
                        fi

                        git -C "${BUILD_DIR}" fetch --depth 1 origin main
                        git -C "${BUILD_DIR}" reset --hard FETCH_HEAD
                        # node_modules와 플러그인 캐시는 지우지 않고 재사용한다.
                        git -C "${BUILD_DIR}" clean -fd -e node_modules -e .quartz

                        # 토큰이 .git/config에 남지 않게 정리
                        git -C "${BUILD_DIR}" remote set-url origin "https://${REPO}"

                        echo "[checkout] HEAD: $(git -C "${BUILD_DIR}" rev-parse --short HEAD)"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                // Jenkins 이미지에 Node가 없으므로 node:22-alpine 컨테이너로 빌드한다.
                // node_modules와 .quartz/plugins는 BUILD_DIR에 남아 다음 빌드에서 재사용된다.
                sh '''
                    set -eu

                    docker run --rm \
                        -v "${BUILD_DIR}:/app" \
                        -w /app \
                        "${NODE_IMAGE}" \
                        sh -ceu '
                            # plugin install이 github에서 플러그인을 받아오므로 git이 필요하다.
                            apt-get update -qq
                            apt-get install -y -qq --no-install-recommends git >/dev/null
                            npm ci --no-audit --no-fund
                            # --from-config: quartz.config.yaml에 켜둔 플러그인만 설치한다.
                            # 플래그를 빼면 lockfile의 46개를 전부 받아 빌드가 느려진다.
                            npx quartz plugin install --from-config
                            npx quartz build
                            chown -R 1000:1000 /app
                        '

                    test -f "${BUILD_DIR}/public/index.html"
                    echo "[build] $(find "${BUILD_DIR}/public" -type f | wc -l) files generated"
                '''
            }
        }

        stage('Deploy') {
            steps {
                // Jenkins 이미지에 rsync가 없으므로 지우고 다시 복사한다.
                // 정적 파일 수천 개라도 같은 디스크 안 복사라 수 초면 끝난다.
                //
                // 삭제 대신 임시 폴더에 복사한 뒤 교체하면 무중단이 되지만,
                // 개인용 사이트라 그 복잡도는 두지 않는다.
                sh '''
                    set -eu
                    rm -rf "${DEPLOY_DIR:?}"/*
                    cp -a "${BUILD_DIR}/public/." "${DEPLOY_DIR}/"
                    echo "[deploy] $(find "${DEPLOY_DIR}" -type f | wc -l) files deployed"
                '''
            }
        }

        stage('Verify') {
            steps {
                // nginx를 거쳐 응답하는지 확인한다.
                // Basic Auth가 걸려 있으므로 401이 정상이다.
                sh '''
                    set -eu
                    status="$(curl -sS -o /dev/null -w '%{http_code}' \
                        --connect-to notes.kkh-hub.tech:443:vps-nginx:443 \
                        https://notes.kkh-hub.tech/ || true)"

                    echo "[verify] HTTP $status"
                    test "$status" = "401"
                '''
            }
        }
    }
}
